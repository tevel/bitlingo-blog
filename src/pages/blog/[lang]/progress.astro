---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { LEVELS, XP_REWARDS } from '../../../utils/gamification';
import { SUPPORTED_LANGS, DEFAULT_LANG, SITE_TITLE } from '../../../consts';
import { UI_TRANSLATIONS, getUITranslation } from '../../../data/vocabulary';

export function getStaticPaths() {
	return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!SUPPORTED_LANGS.includes(lang)) {
	return Astro.redirect(`/blog/${DEFAULT_LANG}/progress`, 308);
}

const uiStrings = UI_TRANSLATIONS[lang] || UI_TRANSLATIONS.en;
const pageTitle = `${uiStrings.progress_page_title} | ${SITE_TITLE}`;
const pageDescription = uiStrings.progress_page_description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead 
      title={pageTitle} 
      description={pageDescription}
      keywords={['progress', 'levels', 'XP', 'gamification', 'language learning', 'BitLingo']}
    />
  </head>
  <body>
    <Header lang={lang} />
    
    <main class="progress-page">
      <article class="progress-article">
        <header class="article-header">
          <h1>{uiStrings.progress_page_title}</h1>
          <p class="article-subtitle">{uiStrings.progress_page_subtitle}</p>
        </header>

        <div class="article-content">
          <!-- How to Earn XP -->
          <section class="xp-guide">
            <h2>{uiStrings.progress_page_how_to_earn_xp}</h2>
            <p>{uiStrings.progress_page_earn_xp_description}</p>
            
            <div class="xp-rewards-list">
              <a href={`/blog/${lang}`} class="xp-reward-item">
                <span class="xp-icon">📖</span>
                <div class="xp-reward-content">
                  <strong>{uiStrings.progress_read_articles}</strong>
                  <span class="xp-amount">{uiStrings.progress_xp_per_article}</span>
                  <p>{uiStrings.progress_page_read_articles_desc}</p>
                </div>
              </a>
              
              <a href={`/blog/${lang}/games`} class="xp-reward-item">
                <span class="xp-icon">🎯</span>
                <div class="xp-reward-content">
                  <strong>{uiStrings.progress_complete_quizzes}</strong>
                  <span class="xp-amount">{uiStrings.progress_xp_per_quiz}</span>
                  <p>{uiStrings.progress_page_complete_quizzes_desc}</p>
                </div>
              </a>
              
              <a href={`/blog/${lang}/games`} class="xp-reward-item">
                <span class="xp-icon">🎮</span>
                <div class="xp-reward-content">
                  <strong>{uiStrings.progress_play_games}</strong>
                  <span class="xp-amount">{uiStrings.progress_xp_per_game}</span>
                  <p>{uiStrings.progress_page_play_games_desc}</p>
                </div>
              </a>
              
              <div class="xp-reward-item">
                <span class="xp-icon">🔥</span>
                <div class="xp-reward-content">
                  <strong>{uiStrings.progress_daily_visit}</strong>
                  <span class="xp-amount">{uiStrings.progress_xp_daily_bonus}</span>
                  <p>{uiStrings.progress_page_daily_visit_desc?.replace('{streakBonus}', String(XP_REWARDS.STREAK_BONUS)) || `${uiStrings.progress_daily_visit}: ${uiStrings.progress_xp_daily_bonus}`}</p>
                </div>
              </div>
              
              <div class="xp-reward-item">
                <span class="xp-icon">🚀</span>
                <div class="xp-reward-content">
                  <strong>{uiStrings.progress_page_first_visit}</strong>
                  <span class="xp-amount">+{XP_REWARDS.FIRST_VISIT} {uiStrings.progress_xp} bonus</span>
                  <p>{uiStrings.progress_page_first_visit_desc}</p>
                </div>
              </div>
            </div>
          </section>

          <!-- All Levels -->
          <section class="levels-section">
            <h2>{uiStrings.progress_page_all_levels}</h2>
            <p>{uiStrings.progress_page_all_levels_desc}</p>
            
            <div class="levels-grid">
              {LEVELS.map((level) => (
                <div class="level-card">
                  <div class="level-header">
                    <span class="level-number">{uiStrings.progress_page_level} {level.level}</span>
                    <span class="level-title">{getUITranslation(lang, `progress_level_${level.title.toLowerCase()}`) || level.title}</span>
                  </div>
                  <div class="level-xp">
                    {level.level === 1 ? (
                      <span>{uiStrings.progress_page_starting_level}</span>
                    ) : (
                      <span>{level.xp} {uiStrings.progress_xp} {uiStrings.progress_page_xp_required}</span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Tips Section -->
          <section class="tips-section">
            <h2>{uiStrings.progress_page_tips_title}</h2>
            <ul class="tips-list">
              <li><strong>{uiStrings.progress_page_tip_visit_daily}</strong> {uiStrings.progress_page_tip_visit_daily_desc}</li>
              <li><strong>{uiStrings.progress_page_tip_read_articles}</strong> {uiStrings.progress_page_tip_read_articles_desc}</li>
              <li><strong>{uiStrings.progress_page_tip_complete_quizzes}</strong> {uiStrings.progress_page_tip_complete_quizzes_desc}</li>
              <li><strong>{uiStrings.progress_page_tip_play_games}</strong> {uiStrings.progress_page_tip_play_games_desc}</li>
              <li><strong>{uiStrings.progress_page_tip_set_goals}</strong> {uiStrings.progress_page_tip_set_goals_desc}</li>
            </ul>
          </section>
        </div>
      </article>
    </main>

    <Footer lang={lang} />
  </body>
</html>

<style>
  .progress-page {
    min-height: 100vh;
    background: var(--gradient-bg);
    padding: 3rem 1rem;
    position: relative;
  }

  .progress-article {
    max-width: 1000px;
    margin: 0 auto;
    background: var(--gradient-card), var(--bg-card);
    border-radius: var(--radius-lg);
    padding: 3rem;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--border-subtle);
    position: relative;
    overflow: hidden;
  }

  .article-header {
    text-align: center;
    margin-bottom: 4rem;
    padding-bottom: 2.5rem;
    border-bottom: 2px solid var(--border-subtle);
    position: relative;
  }

  .article-header::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 2px;
    background: var(--gradient-primary);
  }

  .article-header h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .article-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .article-content {
    line-height: 1.8;
  }

  .article-content > section {
    margin-bottom: 4rem;
  }

  .article-content h2 {
    font-size: clamp(1.8rem, 3vw, 2.25rem);
    margin-top: 0;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
    position: relative;
    padding-bottom: 1rem;
    font-weight: 700;
  }

  .article-content h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60px;
    height: 3px;
    background: var(--gradient-primary);
    border-radius: 2px;
  }

  .article-content p {
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  /* XP Guide */
  .xp-rewards-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .xp-reward-item {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 2rem;
    background: var(--gradient-card), var(--bg-primary);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
  }

  .xp-reward-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--gradient-primary);
    transform: scaleY(0);
    transition: transform 0.3s ease;
  }

  .xp-reward-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-elevated), var(--glow-orange);
    border-color: var(--border-accent);
    text-decoration: none;
    color: inherit;
  }

  .xp-reward-item:hover::before {
    transform: scaleY(1);
  }

  .xp-icon {
    font-size: 3rem;
    flex-shrink: 0;
    filter: drop-shadow(0 2px 8px rgba(245, 166, 35, 0.3));
    transition: transform 0.3s ease;
  }

  .xp-reward-item:hover .xp-icon {
    transform: scale(1.1) rotate(5deg);
  }

  .xp-reward-content {
    flex: 1;
  }

  .xp-reward-content strong {
    display: block;
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
    font-weight: 700;
  }

  .xp-amount {
    display: inline-flex;
    align-items: center;
    background: var(--gradient-primary);
    color: #1a365d;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    box-shadow: 0 2px 8px rgba(245, 166, 35, 0.3);
  }

  .xp-reward-content p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
  }

  /* Levels Section */
  .levels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .level-card {
    background: var(--gradient-card), var(--bg-primary);
    border: 2px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 2rem 1.5rem;
    text-align: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .level-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gradient-primary);
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .level-card:hover {
    transform: translateY(-6px);
    border-color: var(--border-accent);
    box-shadow: var(--shadow-card), var(--glow-orange);
  }

  .level-card:hover::before {
    transform: scaleX(1);
  }

  .level-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .level-number {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .level-title {
    font-size: 1.6rem;
    font-weight: 800;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.01em;
  }

  .level-xp {
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-weight: 500;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-sm);
    display: inline-block;
  }

  /* Tips Section */
  .tips-list {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }

  .tips-list li {
    padding: 1.5rem;
    background: var(--gradient-card), var(--bg-primary);
    border-left: 4px solid var(--accent-primary);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .tips-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--gradient-primary);
    transform: scaleY(0);
    transition: transform 0.3s ease;
  }

  .tips-list li:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-card);
  }

  .tips-list li:hover::before {
    transform: scaleY(1);
  }

  .tips-list li strong {
    color: var(--text-primary);
    font-weight: 700;
    display: inline-block;
    margin-right: 0.5rem;
  }

  @media (max-width: 768px) {
    .progress-page {
      padding: 2rem 0.75rem;
    }

    .progress-article {
      padding: 2rem 1.5rem;
      border-radius: var(--radius-md);
    }

    .article-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
    }

    .article-content > section {
      margin-bottom: 3rem;
    }

    .xp-reward-item {
      flex-direction: column;
      text-align: center;
      padding: 1.5rem;
      gap: 1rem;
    }

    .xp-icon {
      font-size: 2.5rem;
    }

    .xp-reward-content strong {
      font-size: 1.2rem;
    }

    .levels-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 1rem;
    }

    .level-card {
      padding: 1.5rem 1rem;
    }

    .level-title {
      font-size: 1.4rem;
    }

    .tips-list li {
      padding: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .progress-page {
      padding: 1.5rem 0.5rem;
    }

    .progress-article {
      padding: 1.5rem 1rem;
    }

    .levels-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
